# Copy this file to .env and fill in your own Spotify app credentials.
# Create an app at https://developer.spotify.com/dashboard to get a Client ID.

REACT_APP_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Must exactly match a Redirect URI configured on your Spotify app
# (Dashboard > your app > Settings > Redirect URIs).
# Spotify only allows plain http:// for the literal loopback address
# 127.0.0.1 - "localhost" is rejected ("redirect_uri: Insecure"), so use
# 127.0.0.1 for local dev and open the app at http://127.0.0.1:3000, not
# http://localhost:3000. Non-loopback redirect URIs must use https://.
REACT_APP_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000
